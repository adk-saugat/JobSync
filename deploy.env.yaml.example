# Copy to deploy.env.yaml (gitignored), fill in, then deploy:
#
#   gcloud run deploy jobsync \
#     --project jobsync-506205 \
#     --env-vars-file deploy.env.yaml \
#     ...

DATABASE_URL: "postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SYNC_SECRET: "your-sync-secret-from-openssl-rand-hex-32"
# Same OAuth client as oauth_client.json (Cloud Run needs these at runtime)
GOOGLE_OAUTH_CLIENT_ID: "YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET: "YOUR_CLIENT_SECRET"
# Used by the web setup wizard (OAuth callback + cookies)
PUBLIC_BASE_URL: "https://jobsync-b7ltqpwroa-uc.a.run.app"
